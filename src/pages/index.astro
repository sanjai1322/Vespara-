---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';

import Hero from '../components/sections/01-hero.astro';
import Elevation from '../components/sections/02-elevation.astro';
import Materials from '../components/sections/03-materials.astro';
import Interior from '../components/sections/04-interior.astro';
import Location from '../components/sections/05-location.astro';
import Residences from '../components/sections/06-residences.astro';
import Amenities from '../components/sections/07-amenities.astro';
import Aerial from '../components/sections/08-aerial.astro';
import Enquire from '../components/sections/09-enquire.astro';
---

<Base>
  <a id="top"></a>
  <Nav />

  <main>
    <Hero />
    <Elevation />
    <Materials />
    <Interior />
    <Location />
    <Residences />
    <Amenities />
    <Aerial />
    <Enquire />
  </main>
</Base>
